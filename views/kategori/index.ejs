<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kategori Barang</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <a href="/kategori/create" class="btn btn-sm btn-primary">Tambah Data</a>

    <% if (messages.success) {%>
        <div class="alert alert-success timeOut">
            <%- messages.success %>
        </div>
    <% } %>
    <% if (messages.error) {%>
        <div class="alert alert-danger timeOut">
            <%- messages.error %>
        </div>
    <% } %>

    <div class="container mt-5">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Daftar Kategori Barang</h4>
            </div>
            <div class="card-body">
                <table class="table table-bordered table-hover">
                    <thead class="table-light">
                    </thead>
                    <tbody>
                        <% for(var i = 0; i < data.length; i++) {%>

                            <tr>
                                <th scope="row"><%= (i+1) %></th>
                                <td><%= data[i].nama_kategori %></td>
                                <td>
                                    <a href="/kategori/edit/<%= data[i].id_kategori %>" class="btn btn-sm btn-warning">Edit</a>
                                    <a href="/kategori/delete/<%= data[i].id_kategori %>" class="btn btn-sm btn-danger">Delete</a>
                                </td>
                            </tr>

                        <% } %>


                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
<script>
  setTimeout(() => {
        document.querySelectorAll('.timeOut').forEach(el => {
            el.style.display = 'none';
        });
    }, 2000);
</script>
</html>