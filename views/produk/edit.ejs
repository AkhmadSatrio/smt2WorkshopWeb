<%- include('../partials/_head') %>

<div class="container mt-4">
  <div class="card shadow-sm">
    <div class="card-header bg-warning text-dark">
      <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Edit Produk</h4>
    </div>
    <div class="card-body">
      <form action="/produk/update/<%= id %>" method="POST">
        <div class="mb-3">
          <label for="nama_produk" class="form-label">Nama Produk</label>
          <input type="text" class="form-control" id="nama_produk" name="nama_produk" value="<%= nama_produk %>" required>
        </div>

        <div class="mb-3">
          <label for="harga" class="form-label">Harga</label>
          <input type="text" class="form-control" id="harga" name="harga" value="<%= harga %>" required>
        </div>

        <div class="mb-3">
          <label for="id_kategori" class="form-label">Kategori</label>
          <select class="form-select" id="id_kategori" name="id_kategori" required>
            <option value="">-- Pilih Kategori --</option>
            <% for(var i = 0; i < kategori.length; i++) { %>
              <option value="<%= kategori[i].id_kategori %>" 
                <%= kategori[i].id_kategori == id_kategori ? 'selected' : '' %>>
                <%= kategori[i].nama_kategori %>
              </option>
            <% } %>
          </select>
        </div>

        <button type="submit" class="btn btn-warning">
          <i class="bi bi-save"></i> Update
        </button>
        <a href="/produk" class="btn btn-secondary">
          <i class="bi bi-arrow-left"></i> Kembali
        </a>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/_foot') %>