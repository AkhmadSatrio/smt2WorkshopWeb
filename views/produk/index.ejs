<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Produk</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        .table-hover tbody tr:hover {
            background-color: #f1f5f9;
            transition: 0.3s;
        }
    </style>
</head>
<body class="bg-light">

    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="fw-bold">Manajemen Produk</h2>
            <a href="/produk/create" class="btn btn-sm btn-primary">
                <i class="bi bi-plus-circle"></i> Tambah Produk
            </a>
        </div>

        <% if (messages.success) { %>
            <div class="alert alert-success timeOut">
                <i class="bi bi-check-circle"></i> <%- messages.success %>
            </div>
        <% } %>
        <% if (messages.error) { %>
            <div class="alert alert-danger timeOut">
                <i class="bi bi-exclamation-triangle"></i> <%- messages.error %>
            </div>
        <% } %>

        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Daftar Produk</h4>
            </div>
            <div class="card-body">
                <input type="text" id="search" class="form-control mb-3" placeholder="Cari produk...">

                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width:5%">No</th>
                            <th style="width:30%">Nama Produk</th>
                            <th style="width:20%">Harga</th>
                            <th style="width:20%">Kategori</th>
                            <th style="width:25%">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for(var i = 0; i < data.length; i++) { %>
                            <tr>
                                <td><%= (i+1) %></td>
                                <td><%= data[i].nama_produk %></td>
                                <td>
                                    <%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR' }).format(data[i].harga) %>
                                </td>
                                <td><%= data[i].nama_kategori %></td>
                                <td>
                                    <a href="/produk/edit/<%= data[i].id_produk %>" class="btn btn-sm btn-warning me-1">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </a>
                                    <a href="/produk/delete/<%= data[i].id_produk %>" 
                                       class="btn btn-sm btn-danger"
                                       onclick="return confirm('Yakin ingin menghapus produk ini?')">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

<script>
    setTimeout(() => {
        document.querySelectorAll('.timeOut').forEach(el => {
            el.classList.add('fade');
            setTimeout(() => el.remove(), 500);
        });
    }, 2000);

    document.getElementById('search').addEventListener('keyup', function() {
        let filter = this.value.toLowerCase();
        document.querySelectorAll('tbody tr').forEach(row => {
            row.style.display = row.innerText.toLowerCase().includes(filter) ? '' : 'none';
        });
    });
</script>
</body>
</html>