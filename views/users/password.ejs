<%- include('../partials/_head') %>

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">Edit Kategori</h5>
        </div>
        <div class="card-body">
            <form action="/kategori/update/<%= id %>" method="post">
                <div class="mb-3">
                    <label for="nama_kategori" class="form-label">Nama Kategori</label>
                    <input type="text" class="form-control" id="nama_kategori" name="nama_kategori" value="<%= nama_kategori %>" required>
                </div>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check2"></i> Perbarui
                </button>
                <a href="/kategori" class="btn btn-secondary ms-2">Batal</a>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/_foot') %>